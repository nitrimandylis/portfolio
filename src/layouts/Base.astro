---
// every page: head, the signature top-left (links home), then the page. subpages carry nothing else.
import '../styles/site.css';
const { title = 'nick trim', description = 'nick trim. athens. films, music, photos, and the things i build.', home = false } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#0a0a0a">
<link rel="preload" href="/fonts/Archivo.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="nick trim">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content="https://nicktrim.com/og.png">
<meta name="twitter:card" content="summary_large_image">
</head>
<body class={home ? 'home' : undefined}>
{home ? <slot name="top" /> : <header class="top"><a class="sig" href="/" aria-label="nick trim, home"></a></header>}
<slot />
</body>
</html>
