---
// every page: head, the bar (signature, numbered nav, night shift), then the page inside the grid frame.
// `current` lights up one nav item. the load sequence plays on the first page of a session only.
import '../styles/site.css';
const { title = 'nick trimandylis', description = 'nick trimandylis. athens, final-year ib. builds tools, shoots photos, watches films.', current = '' } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  ['work', '/work', '01'],
  ['photos', '/photos', '02'],
  ['films', '/films', '03'],
  ['contact', '/#contact', '04'],
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#0c0d14">
<link rel="preload" href="/fonts/Anton.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Schibsted.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/JetBrainsMono.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="nick trimandylis">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content="https://nicktrim.com/og.png">
<meta name="twitter:card" content="summary_large_image">
<script is:inline>
  // first page of the session plays the intro. any key, click, wheel or touch ends it at once.
  if (!sessionStorage.getItem('seen') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const root = document.documentElement;
    root.classList.add('intro');
    sessionStorage.setItem('seen', '1');
    const stop = () => root.classList.remove('intro');
    for (const ev of ['keydown', 'pointerdown', 'wheel', 'touchstart']) addEventListener(ev, stop, { once: true, passive: true });
    setTimeout(stop, 1000);
  }
</script>
</head>
<body>
<div class="frame">
  <header class="bar g L">
    <a class="sig s3 m1 R" href="/" aria-label="nick trimandylis, home"><i></i></a>
    <nav class="s6 m3 R mR0" aria-label="pages">
      {nav.map(([name, href, n]) => (
        <a href={href} aria-current={current === name ? 'page' : undefined}><span class="long">{n} {name}</span><span class="short">{n}</span></a>
      ))}
    </nav>
    <a class="ns s3" href="https://os.nicktrim.com">night shift → os.nicktrim.com</a>
  </header>
  <slot />
</div>
</body>
</html>
