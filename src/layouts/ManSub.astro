---
// every /man page except the home: a link back to the man page, a title, then the page. the joke is told once, on the home.
import Page from './Page.astro';
const { title, heading, note = '', description } = Astro.props;
---
<Page title={title} description={description}>
  <main class="sub">
    <a class="back noprint" href="/man">← nick(1)</a>
    <h1>{heading}{note && <span class="mu"> · {note}</span>}</h1>
    <slot />
  </main>
</Page>
<style>
  .sub{max-width:110ch;margin:0 auto;padding:48px 24px 80px}
  .back{display:inline-block;margin-bottom:40px}
  h1{margin-bottom:32px}
  @media (max-width:640px){.sub{padding:24px 14px 56px}.back{margin-bottom:28px}h1{margin-bottom:22px}}
  @media print{.sub{padding:0;max-width:none}}
</style>
