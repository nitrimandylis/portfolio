---
// the long version of the man page's DESCRIPTION. rows, not paragraphs: each line says one thing, the jokes live in the grey notes.
// each section is [heading, note, rows]; a row is [key, what, right]. right is optional and prints grey, on its own line under what.
import ManSub from '../layouts/ManSub.astro';
import signature from '../../public/hand/name.svg?raw'; // inline, so the strokes take the text colour. take 6 of 8 from Quick sheets p200, 2026-10-14

const sections = [
  ['origin', '', [
    ['age 9', 'Minecraft mods, datapacks, my own 3D models in Blockbench. no code yet'],
    ['age 13', 'first code, a Pygame course'],
    ['2024-25', 'Akademix with friends: 2nd nationally, hooked on startups'],
    ['2026', "tokenpilot, built for Omilia's CTO"],
  ]],
  ['how i work', 'minus the Vicodin and the fake psychic act', [
    ['problems', "like House: don't trust the spec, run the test myself"],
    ['people', 'like Jane: read the room'],
    ['ideas', 'when i drop one, i write down why'],
  ]],
  ['ventures', '', [
    ['Akademix', 'replaces the apps a school runs on, with AI quizzes from the teacher\'s notes', 'co-founder, commercial lead · 2nd nationally, JA Greece'],
    ['MindReset', 'catches study fatigue in teens before burnout', 'built the app, owned the roadmap · 1st, MIT FutureBuilders'],
    ['ASKUS', 'drones that fly medicine to elderly islanders, ordered by phone call', 'business plan · top 10 of 130, IST Crazy Business Ideas'],
    ['ClearFeed', 'a browser extension that fact-checks social posts for teens', 'built the app, owned the roadmap · 3rd, ACSTAC'],
    ['Kizuna', "a student-led committee for my school's IB students", 'founder · retired 2026'],
  ]],
  ['off the keyboard', 'i rate films too generously', [
    ['photos', 'wherever i end up'],
    ['films', 'Spider-Verse, Shutter Island, Pacific Rim'],
    ['series', 'House, The Mentalist'],
    ['music', 'The Neighbourhood, Arctic Monkeys, The Weeknd, Kanye'],
  ]],
  ['next', '', [
    ['2026-27', 'hackathons with friends, NASA Space Apps first'],
    ['2027', 'aiming for UCL, Information Management for Business'],
  ]],
];
// keys that open a page of their own
const pages = { photos: '/photos', films: '/films' };
---
<ManSub title="about, Nick Trimandylis" heading="about" note="the long version"
  description="Nick Trimandylis, the long version: where he started, how he works, his ventures, and what's next.">
  <div class="top">
    <div class="pol">
      <img src="/img/about-800.webp" alt="" width="450" height="800">
      <span>Thessaloniki, March 2026</span>
    </div>
    <div class="sig" aria-hidden="true"><Fragment set:html={signature} /></div>
  </div>
  <p class="lead">Nick Trimandylis. Athens, final-year IB.<br>computer science since forever, business since 2024.</p>
  {sections.map(([heading, note, rows]) => (
    <section>
      <h2><b>{heading.toUpperCase()}</b>{note && <span class="mu"> · {note}</span>}</h2>
      <div class="rows">
        {rows.map(([key, what, right]) => (
          <div class="row">
            {pages[key] ? <a href={pages[key]}>{key}</a> : <span>{key}</span>}
            <span class="what">{what}{right && <span class="mu right">{right}</span>}</span>
          </div>
        ))}
      </div>
    </section>
  ))}
</ManSub>
<style>
  /* one polaroid of nick, clipped to the top of the page like the prints on the home */
  /* the photo and the signature side by side, the signature sitting at the bottom edge like it was signed next to the print */
  .top{display:flex;align-items:flex-end;gap:40px;margin-bottom:2em}
  .sig{color:var(--fg);padding-bottom:28px;transform:rotate(-2deg)}
  .sig :global(svg){width:260px;height:auto;display:block}
  .pol{display:block;width:320px;flex:none;background:#efe9dc;color:#3a3129;padding:18px 18px 0;border-radius:1px;transform:rotate(-1.5deg);box-shadow:0 1px 2px rgba(0,0,0,.6),0 10px 24px -8px rgba(0,0,0,.8)}
  .pol img{width:100%;height:auto;aspect-ratio:1;object-fit:cover}
  .pol span{display:block;font-size:12px;line-height:1.3;padding:12px 0 14px}
  @media (max-width:640px){.top{flex-direction:column;align-items:flex-start;gap:16px}.pol{width:100%;max-width:320px}.sig{padding:0 0 0 12px}.sig :global(svg){width:220px}}
  .pol:hover{transform:rotate(0deg)}
  .lead{margin-bottom:.4em}
  section{margin-top:2em}
  h2{margin-bottom:.6em}
  .rows{--key:11ch;grid-template-columns:var(--key) 1fr}
  .right{display:block}
  @media (max-width:640px){.rows{grid-template-columns:1fr}}
  .rows a{justify-self:start}
</style>
