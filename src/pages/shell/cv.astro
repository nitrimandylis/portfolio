---
// the cv as `cat cv`. printing it (⌘P) gives the paper version.
import Shell from '../../layouts/Shell.astro';
import Cmd from '../../components/Cmd.astro';
import CvRows from '../../components/CvRows.astro';
import { contact, month } from '../../data/site';
---
<Shell title="cv, nick trimandylis" cwd="~" description="nick trimandylis's cv, the short one.">
  <Cmd cmd="cat cv"><p>nick trimandylis, athens. as of {month}.</p></Cmd>
  <div class="gap"><CvRows /></div>
  <Cmd cmd="cat cv --long">
    <p>want the full one? <a href="mailto:nicktrim8@duck.com?subject=the long cv">email me.</a> <button class="link noprint" onclick="print()">print</button></p>
    <p class="mu">{contact.map(([label, href], i) => <>{i > 0 && ' · '}<a href={href}>{label}</a></>)}</p>
  </Cmd>
</Shell>
<style>.gap{margin:1em 0 1.6em}button{margin-left:2ch}</style>
