---
// after `open photos/`: the prints as one sideways strip. click one to project it.
import Shell from '../../layouts/Shell.astro';
import Cmd from '../../components/Cmd.astro';
import Prints from '../../components/Prints.astro';
import { photos } from '../../data/site';
---
<Shell title="photos, Nick Trimandylis" cwd="~/photos" description="Nick Trimandylis's photos.">
  <Cmd cmd="open photos/"><p class="mu">{photos.length} frames, in order. click to project, ← → to move, q to quit.</p></Cmd>
  <div class="gap full"><Prints strip /></div>
</Shell>
<style>.gap{margin-top:1.4em}</style>
