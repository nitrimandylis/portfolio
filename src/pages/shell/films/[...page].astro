---
// `cat films.md`, 30 entries a page (/shell/films, /shell/films/2, ...). data/films.json is appended daily by the action.
import type { GetStaticPaths } from 'astro';
import Shell from '../../../layouts/Shell.astro';
import Cmd from '../../../components/Cmd.astro';
import FilmRows from '../../../components/FilmRows.astro';
import { films, logged, thisYear, favourites } from '../../../data/films';

export const getStaticPaths = (({ paginate }) => paginate(films, { pageSize: 30 })) satisfies GetStaticPaths;
const { page } = Astro.props;
---
<Shell title="films, Nick Trimandylis" cwd="~/films" description="Nick Trimandylis's film diary, from Letterboxd.">
  <Cmd cmd={page.currentPage === 1 ? 'cat films.md' : `cat films.md | tail -n +${(page.currentPage - 1) * 30 + 1}`}>
    {page.currentPage === 1 && <>
      <p>usually ★★★★★. i like films. {logged} in the diary, {thisYear} this year.</p>
      <p class="mu">favourites: {favourites.map(([t, u], i) => <>{i > 0 && ', '}<a href={u}>{t}</a></>)}</p>
    </>}
  </Cmd>
  <div class="gap"><FilmRows films={page.data} /></div>
  <p class="mu pager">
    {page.url.prev && <a href={page.url.prev}>← newer</a>}
    {page.url.next && <a href={page.url.next}>older →</a>}
    <span>-- page {page.currentPage}/{page.lastPage} --, the rest is on <a href="https://letterboxd.com/nick_trim8/">Letterboxd</a>.</span>
  </p>
</Shell>
<style>
  .gap{margin:1em 0}
  .pager{display:flex;gap:3ch;flex-wrap:wrap}
</style>
