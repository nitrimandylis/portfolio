---
// the man(1) home: nick as a manual page, typed into a terminal. `man nicktrim` on top, back at the prompt at the end. the only page that keeps the format; the rest are plain.
import Page from '../layouts/Page.astro';
import { featured } from '../data/work';
import { logged, latest } from '../data/films';
import { photos, projectCount, song, month, history, examples } from '../data/site';
const pad = (n: number) => String(n).padStart(2, '0');
---
<Page>
  <header class="titleline mu">nick@athens ~</header>
  <main class="man">
    <p class="prompt"><span class="mu">❯</span> man nicktrim</p>
    <div class="hf top"><span>NICKTRIM(1)</span><span class="mu">General Commands Manual</span><span>NICKTRIM(1)</span></div>

    <section><h2>NAME</h2>
      <div class="b">nicktrim - Nick Trimandylis, Athens, final-year IB. builds tools, ships them.</div></section>

    <section><h2>SYNOPSIS</h2>
      <div class="b"><b>nicktrim</b> [<a href="/about">about</a> | <a href="/work">work</a> | <a href="/films">films</a> | <a href="/photos">photos</a> | <a href="/cv">cv</a>] <span class="nw">[<a href="mailto:nicktrim8@duck.com">--email</a>]</span></div></section>

    <section><h2>DESCRIPTION</h2>
      <div class="b">
        <p>i build tools for problems i have, then keep using them. most of them run in a terminal.</p>
        <p>off the keyboard it's films, music, and photos of wherever i end up.</p>
        <p>the long version: <a href="/about">about/</a></p>
      </div></section>

    <section><h2>EXAMPLES</h2>
      <div class="b">
        <p><a href="/photos">nicktrim photos</a></p>
        <p class="mu">four of {photos.length}. the rest under <a href="/photos">photos/</a>.</p>
        <div class="examples">
          {examples.map(p => (
            <a href={`/photos#${p.file}`}>
              <img src={`/img/photos/${p.file}-600.webp`} alt={p.name} width={p.w} height={p.h} style={`aspect-ratio:${p.w}/${p.h}`}>
              <span class="mu">{pad(p.num)} {p.name}</span>
            </a>
          ))}
        </div>
      </div></section>

    <section><h2>FILES</h2>
      <div class="b kv">
        <a href="/work">work/</a><span>{featured.length} featured, {projectCount} total</span>
        <a href="/films">films/</a><span>{logged} in the diary, usually five stars</span>
        <a href="/photos">photos/</a><span>{photos.length} prints, in order</span>
      </div></section>

    <section><h2>ENVIRONMENT</h2>
      <div class="b kv">
        <span>ON_REPEAT</span><span>{song}</span>
        {latest && <><span>LAST_WATCHED</span><span>{latest.title}, {latest.year}{latest.rewatch && ', again'}</span></>}
      </div></section>

    <section><h2>HISTORY</h2>
      <div class="b kv">
        {history.map(([year, what]) => <><span>{year}</span><span>{what}</span></>)}
      </div></section>

    <section><h2>BUGS</h2>
      <div class="b">occasionally finishes them.</div></section>

    <section><h2>SEE ALSO</h2>
      <div class="b"><a href="/cv">cv(7)</a>, <a href="https://os.nicktrim.com">night-shift(8)</a>, <a href="https://www.linkedin.com/in/nitrimandylis">linkedin(1)</a>, <a href="https://github.com/nitrimandylis">github(1)</a></div></section>

    <div class="hf bottom mu"><span>nicktrim.com</span><span>{month}</span><span>NICKTRIM(1)</span></div>
    <p class="end" aria-hidden="true"><span class="mu">❯</span> <span class="cursor"></span></p>
  </main>
</Page>
<style>
  .man{max-width:calc(80ch + 48px);margin:0 auto;padding:64px 24px;min-height:calc(100vh - 40px);display:flex;flex-direction:column;justify-content:center}
  /* three equal-weight cells, so the middle one sits on the true centre whatever the sides say */
  .hf{display:grid;grid-template-columns:1fr auto 1fr;gap:2ch}
  .hf span:last-child{justify-self:end}
  .prompt{margin-bottom:1.6em}
  .top{margin-bottom:1.6em}
  .bottom{margin-top:1.6em}
  .end{margin-top:1.6em}
  section{margin-top:1.6em}
  h2{font-weight:700}
  .b{padding-left:7ch}
  .b p+p{margin-top:1em}
  .b p.mu{margin-top:0}
  .kv{display:grid;grid-template-columns:14ch 1fr;column-gap:1ch}
  .kv a{justify-self:start}
  .nw{white-space:nowrap}
  /* four prints in a row at their own shape, captions under. a phone gets two by two */
  .examples{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;align-items:start;margin-top:1em}
  .examples a{text-decoration:none}
  .examples img{width:100%;height:auto}
  .examples a:hover img{outline:1px solid var(--fg);outline-offset:3px}
  .examples span{display:block;font-size:12px;margin-top:4px}
  @media (max-width:640px){
    .man{padding:28px 14px;justify-content:flex-start}
    .b{padding-left:3ch}
    .hf{font-size:.9em}
    .kv{grid-template-columns:13ch 1fr}
    .examples{grid-template-columns:1fr 1fr}
  }
</style>
