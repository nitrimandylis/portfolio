---
// photos: a contact sheet of every print, newest first. clicking a frame opens the projector: one print large,
// the strip underneath as a scrubber. arrow keys, the wheel or a swipe move one print, esc closes. /photos#<file> opens straight onto a print.
import Base from '../layouts/Base.astro';
import photosJson from '../../data/photos.json';
const photos = photosJson.photos;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<Base title="photos, nick trimandylis" description="nick trimandylis's photos. lo-fi, cinematic, mine." current="photos">
  <section class="head g">
    <div class="title s9 R"><h1>Photos</h1></div>
    <div class="note s3">{photos.length} prints · newest first<br>lo-fi, cinematic, mine.</div>
  </section>

  <section class="film sheet T" id="sheet">
    <div class="holes"></div>
    <div class="frames">
      {photos.map((p, i) => (
        <button data-i={i} id={p.file} aria-label={`open ${p.name}`}>
          <img src={`/img/photos/${p.file}-600.webp`} alt={p.name} loading="lazy" width={p.w} height={p.h}>
          <span class="num">{pad(i)}</span>
        </button>
      ))}
    </div>
    <div class="holes"></div>
  </section>

  <dialog class="projector" id="projector" aria-label="projector">
    <div class="screen marks">
      <img alt="">
      <span class="mk tl"></span><span class="mk tr"></span><span class="mk bl"></span><span class="mk br"></span>
      <button class="close">← sheet</button>
      <span class="count"></span>
      <span class="cap"></span>
      <span class="keys">← → / swipe · esc close</span>
    </div>
    <div class="scrub film">
      <div class="holes"></div>
      <div class="frames">
        {photos.map((p, i) => <button data-i={i} aria-label={p.name}><img src={`/img/photos/${p.file}-600.webp`} alt="" loading="lazy" width={p.w} height={p.h}></button>)}
      </div>
      <div class="holes"></div>
    </div>
  </dialog>

  <script is:inline define:vars={{ photos }}>
    const box = document.getElementById('projector');
    const big = box.querySelector('.screen img');
    const cap = box.querySelector('.cap'), count = box.querySelector('.count');
    const thumbs = [...box.querySelectorAll('.scrub button')];
    const pad = i => String(i + 1).padStart(2, '0');
    let current = 0;

    function show(i) {
      current = (i + photos.length) % photos.length;   // wrap at both ends
      const p = photos[current];
      big.src = `/img/photos/${p.file}-1600.webp`;
      big.alt = p.name;
      big.style.animation = 'none'; big.offsetWidth; big.style.animation = '';   // replay the fade
      cap.textContent = `${pad(current)} — ${p.name}`;
      count.textContent = `${pad(current)} / ${photos.length}`;
      thumbs.forEach((t, j) => t.toggleAttribute('aria-current', j === current));
      thumbs[current].scrollIntoView({ block: 'nearest', inline: 'center' });
      history.replaceState(null, '', `#${p.file}`);
      if (!box.open) box.showModal();
    }

    document.getElementById('sheet').addEventListener('click', e => {
      const b = e.target.closest('button');
      if (b) show(Number(b.dataset.i));
    });
    box.querySelector('.scrub').addEventListener('click', e => {
      const b = e.target.closest('button');
      if (b) show(Number(b.dataset.i));
    });
    box.querySelector('.close').addEventListener('click', () => box.close());
    box.addEventListener('close', () => history.replaceState(null, '', location.pathname));
    // on the document, not the dialog: opened from a /photos#print link, focus is not inside it yet
    document.addEventListener('keydown', e => {
      if (!box.open) return;
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });   // esc closes natively

    // one gesture, one print. a trackpad flick fires dozens of wheel events and keeps firing after the fingers
    // lift, so add the movement up, step once it passes 50px, then ignore the rest until the wheel is quiet for 150ms.
    const screen = box.querySelector('.screen');
    let moved = 0, stepped = false, quiet;
    screen.addEventListener('wheel', e => {
      e.preventDefault();
      clearTimeout(quiet);
      quiet = setTimeout(() => { moved = 0; stepped = false; }, 150);
      if (stepped) return;
      const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      moved += e.deltaMode === 1 ? d * 40 : d;   // firefox counts in lines, not pixels
      if (Math.abs(moved) < 50) return;
      show(current + Math.sign(moved));
      stepped = true;
    }, { passive: false });

    // touch: a sideways swipe of 40px or more moves one print. mostly-vertical swipes and pinches are ignored.
    let startX = null, startY = 0;
    screen.addEventListener('touchstart', e => {
      if (e.touches.length === 1) { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }
      else startX = null;
    }, { passive: true });
    screen.addEventListener('touchend', e => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      startX = null;
      if (Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy)) show(current - Math.sign(dx));   // swipe left = next
    });

    const start = photos.findIndex(p => `#${p.file}` === location.hash);
    if (start >= 0) show(start);
  </script>
</Base>
