---
// cv: the public cut of content/cv.txt as one table. printing it (⌘P) gives the paper version: white, black ink, same grid.
import Base from '../layouts/Base.astro';

// [section, where, what, result]. the section label only shows on the first row of each group.
const rows = [
  ['work', 'omilia, athens', 'intern reporting to the cto. built tokenpilot', 'in production'],
  ['', 'algroup aluminium, athens', 'digitised sales proposals and client quotes', ''],
  ['results', 'akademix, ja greece', 'chief commercial officer · 12 finalists from 100+ plans', '2nd nationally'],
  ['', 'ja greece trade fair', 'product/service promotion', 'award'],
  ['', 'mit raise futurebuilders uk', 'innovation demo', '1st place'],
  ['', 'acstac day of ai hackathon', 'pitch', '3rd place'],
  ['', 'young business talents', 'four rounds of running a simulated company', 'national semi-finals'],
  ['', 'cgsmun', 'head of press · two newspaper issues and all conference photography', ''],
  ['education', 'costeas-geitonas, 2025–27', 'ib diploma · hl maths aa, cs, english b', ''],
  ['', 'costeas-geitonas', 'national academic merit award', 'three years running'],
  ['languages', 'greek', 'native', ''],
  ['', 'english', 'c2 · cambridge proficiency 2023', ''],
  ['', 'spanish', 'a2 · instituto cervantes 2023', ''],
  ['skills', 'python · typescript', 'full-stack web', ''],
];
---
<Base title="cv, nick trimandylis" description="nick trimandylis's cv, the short one." current="contact">
  <section class="head g">
    <div class="title s9 R"><h1>CV</h1></div>
    <div class="note s3">nick trimandylis · athens<br>as of october 2026<br><span class="printonly">nicktrim.com · nicktrim8@duck.com</span><button class="ul noprint" onclick="print()">print →</button></div>
  </section>
  <div class="table cvt g T">
    {rows.map(([sec, where, what, result]) => (
      <div class="row">
        <span class="sec s2 m4 mR0">{sec}</span>
        <span class="name s3 m4 mR0">{where}</span>
        <span class="line s5 m4 mR0">{what}</span>
        <span class="meta s2 m4 mR0">{result}</span>
      </div>
    ))}
  </div>
  <section class="cv-foot g">
    <div class="s9 R"><p class="cv-end">want the full one? <a class="ul" href="mailto:nicktrim8@duck.com?subject=the long cv">email me.</a></p></div>
    <div class="cv-links s3">
      <a class="ul" href="mailto:nicktrim8@duck.com">nicktrim8@duck.com</a>
      <a class="ul" href="https://www.linkedin.com/in/nitrimandylis">linkedin.com/in/nitrimandylis</a>
      <a class="ul" href="https://github.com/nitrimandylis">github.com/nitrimandylis</a>
    </div>
  </section>
</Base>
