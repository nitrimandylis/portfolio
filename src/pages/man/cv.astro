---
// the cv. printing it (⌘P) gives the paper version: white, black ink, same rows.
import ManSub from '../../layouts/ManSub.astro';
import CvRows from '../../components/CvRows.astro';
import { contact, month } from '../../data/site';
---
<ManSub title="cv, nick trimandylis" heading="cv" note={`nick trimandylis, athens, as of ${month}`} description="nick trimandylis's cv, the short one.">
  <CvRows />
  <p class="end">want the full one? <a href="mailto:nicktrim8@duck.com?subject=the long cv">email me.</a>
    <button class="link noprint" onclick="print()">print</button></p>
  <p class="mu">{contact.map(([label, href], i) => <>{i > 0 && ' · '}<a href={href}>{label}</a></>)}</p>
</ManSub>
<style>.end{margin:2.4em 0 .6em}.end button{margin-left:2ch}</style>
