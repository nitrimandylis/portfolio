---
// work: every project as one table row, featured six first.
import Base from '../layouts/Base.astro';
import { featured, rest, links } from '../data/work';
const all = [
  ...featured.map(f => ({ name: f.name, url: f.url, what: f.what, links: links(f.url, f.code) })),
  ...rest.map(([name, url, what]) => ({ name, url, what, links: links(url) })),
];
---
<Base title="work, nick trimandylis" description="everything nick trimandylis has built. tokenpilot, llm-mafia, aidetect, bacpack, gridcast, blither, and the rest." current="work">
  <section class="head g L">
    <div class="title s9 R"><h1>Work</h1></div>
    <div class="note s3"><span class="prompt">❯</span> ls work/ --long --all<br>{all.length} entries · featured first</div>
  </section>
  <div class="table g">
    {all.map((p, i) => (
      <div class="row">
        <span class="n s1 mhide">{String(i + 1).padStart(2, '0')}</span>
        <span class="name s2 m1"><a href={p.url}>{p.name}</a></span>
        <span class="line s7 m3 mR0">{p.what}</span>
        <span class="meta s2 mhide">{p.links.map(([label, href]) => <a href={href}>{label}</a>)}</span>
      </div>
    ))}
  </div>
</Base>
