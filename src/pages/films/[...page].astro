---
// films: the diary as a table, 30 rows a page (/films, /films/2, ...). page 1 also gets the stats and the latest
// film printed as a ticket stub. data/films.json is appended daily by the action, and its push rebuilds every page.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import filmsJson from '../../../data/films.json';
import { stars, favourites } from '../../data/films';

export const getStaticPaths = (({ paginate }) => paginate(filmsJson.films, { pageSize: 30 })) satisfies GetStaticPaths;

const { page } = Astro.props;
const SEED = 64;   // films watched before the letterboxd account existed
const films = filmsJson.films;
const year = new Date().getFullYear();
const thisYear = films.filter(f => f.watched.startsWith(String(year))).length;
const latest = films[0];
const first = page.currentPage === 1;
---
<Base title={first ? 'films, nick trimandylis' : `films ${page.currentPage}, nick trimandylis`} description="nick trimandylis's film diary, from letterboxd." current="films">
  {first ? (
    <section class="head films-head g">
      <div class="title s8 R">
        <h1>Films</h1>
        <div>
          <p class="filmline">usually ★★★★★. i like films.</p>
          <p class="stats">{SEED + films.length} films logged · {thisYear} this year · <a class="ul" href="https://letterboxd.com/nick_trim8/">letterboxd diary →</a><br>
            favourites — {favourites.map(([t, u], i) => <>{i > 0 && ' · '}<a href={u}>{t}</a></>)}</p>
        </div>
      </div>
      {latest && (
        <div class="stubcell s4">
          <a class="stub" href={latest.url} aria-label={`latest: ${latest.title}`}>
            <div class="main">
              <div class="top"><span>ADMIT ONE</span><span>LATEST</span></div>
              <div class="t">{latest.title}</div>
              <div class="grid3"><span>YEAR</span><span>SHOWTIME</span><span>SEAT</span>
                <b>{latest.year}</b><b>{latest.watched}</b><b>{stars(latest.rating) || '—'}</b></div>
              <div class="fine">{latest.rewatch ? 'REWATCH · ' : ''}NO REFUNDS</div>
            </div>
            <div class="tear"></div>
            <div class="tail"><span class="v">ADMIT ONE</span><span class="big">★{latest.rating ?? '—'}</span><span class="d">{latest.watched.slice(5).replace('-', '·')}</span></div>
          </a>
        </div>
      )}
    </section>
  ) : (
    <section class="head g">
      <div class="title s9 R"><h1>Films</h1></div>
      <div class="note s3"><span class="prompt">❯</span> page {page.currentPage}/{page.lastPage}<br>{films.length} entries · newest first</div>
    </section>
  )}

  <div class="table g T">
    <div class="row th">
      <span class="s2 m1">date</span><span class="s4 m2">film</span><span class="s1 mhide">year</span><span class="s1 m1 mR0">★</span><span class="s4 mhide">review</span>
    </div>
    {page.data.map(f => (
      <div class="row">
        <span class="n s2 m1"><time datetime={f.watched}>{f.watched}</time></span>
        <span class="name s4 m2"><a href={f.url}>{f.title}</a>{f.rewatch && <span class="again">again</span>}</span>
        <span class="meta s1 mhide">{f.year}</span>
        <span class="name s1 m1 mR0">{stars(f.rating)}</span>
        <span class="prose s4 mhide">{f.review}</span>
      </div>
    ))}
    {page.lastPage > 1 && (
      <span class="cmd"><span class="prompt">❯</span> page {page.currentPage}/{page.lastPage}
        {page.url.prev && <> · <a class="ul" href={page.url.prev}>← newer</a></>}
        {page.url.next && <> · <a class="ul" href={page.url.next}>older →</a></>}
      </span>
    )}
    <span class="cmd">the rest is on <a class="ul" href="https://letterboxd.com/nick_trim8/">letterboxd</a>.</span>
  </div>
</Base>
