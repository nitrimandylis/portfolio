---
// the diary, 30 a page (/man/films, /man/films/2, ...). data/films.json is appended daily by the action.
import type { GetStaticPaths } from 'astro';
import ManSub from '../../layouts/ManSub.astro';
import FilmRows from '../../components/FilmRows.astro';
import { films, logged, thisYear, favourites } from '../../data/films';

export const getStaticPaths = (({ paginate }) => paginate(films, { pageSize: 30 })) satisfies GetStaticPaths;
const { page } = Astro.props;
---
<ManSub title="films, nick trimandylis" heading="films" note={`${logged} logged, ${thisYear} this year`} description="nick trimandylis's film diary, from letterboxd.">
  {page.currentPage === 1 && <div class="intro">
    <p>usually ★★★★★. i like films.</p>
    <p class="mu">favourites: {favourites.map(([t, u], i) => <>{i > 0 && ', '}<a href={u}>{t}</a></>)}</p>
  </div>}
  <FilmRows films={page.data} />
  <p class="pager mu">
    {page.url.prev && <a href={page.url.prev}>← newer</a>}
    {page.url.next && <a href={page.url.next}>older →</a>}
    <span>page {page.currentPage}/{page.lastPage}, the rest is on <a href="https://letterboxd.com/nick_trim8/">letterboxd</a>.</span>
  </p>
</ManSub>
<style>
  .intro{margin-bottom:2em}
  .pager{margin-top:2em;display:flex;gap:3ch;flex-wrap:wrap}
</style>
