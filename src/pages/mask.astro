---
// variant: the handwritten name fills the width; the photos pass behind it and show through the strokes.
import Base from '../layouts/Base.astro';
import photosJson from '../../data/photos.json';
const photos = photosJson.photos;
---
<Base home title="nick trim">
  <header class="top" slot="top">
    <span></span>
    <p class="bio">athens, final-year ib. builds tools, ships them, occasionally finishes them.</p>
  </header>
  <section class="hero mask" id="hero" aria-label="nick trim">
    <div class="stage">
      <div class="window">
        <ul class="track" id="track">
          {photos.map((p, i) => (
            <li><img src={`/img/photos/${p.file}-1600.webp`} alt="" width="1600" height="1600" loading={i < 3 ? 'eager' : 'lazy'} decoding="async"></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  <section class="about">
    <p>i'm nick. i live in athens and i'm in my last year of the ib. most of my time goes to free time, which i take seriously.</p>
    <p>i start things and then build them. a student business that came second in greece (akademix, with ja), a first place at mit futurebuilders and a third at the acstac day of ai hackathon. the rest of it is under <a href="/work">work</a>.</p>
    <p>off the keyboard it's <a href="/films">films</a>, music, and <a href="/photos">photos</a> that look like they were taken at night, because they were.</p>
  </section>
  <ul class="doors">
    <li><a href="/work">work</a></li><li><a href="/cv">cv</a></li><li><a href="/films">films</a></li><li><a href="/photos">photos</a></li><li><a href="https://os.nicktrim.com">night shift</a></li>
  </ul>
  <footer><div class="now">on repeat <b>sweater weather</b>, the neighbourhood. last watched <b>avengers: endgame</b>.</div>
    <div class="contact"><a href="mailto:nicktrim8@duck.com">email</a><a href="https://www.linkedin.com/in/nitrimandylis" rel="me">linkedin</a></div></footer>
  <style>
    /* the name as a window: the strokes are a mask over a moving row of photos. the stroke width is the whole gesture. */
    .hero.mask{position:relative;z-index:0}
    .hero.mask .stage{height:100vh;position:sticky;top:0;display:flex;align-items:center;overflow:hidden;padding:0 var(--pad)}
    .hero.mask .window{width:100%;aspect-ratio:215/72;max-height:80vh;
      -webkit-mask:url(/hand/name-fill.svg) center/contain no-repeat;mask:url(/hand/name-fill.svg) center/contain no-repeat}
    .hero.mask .track{display:flex;gap:0;padding:0;margin:0;list-style:none;height:100%;will-change:transform}
    .hero.mask .track li{flex:none;height:100%;aspect-ratio:1}
    .hero.mask .track img{width:100%;height:100%;object-fit:cover;filter:brightness(1.1) contrast(1.05)}
    .hero.mask.rail .stage{position:static;height:auto;padding:40px var(--pad)}
    .hero.mask.rail .track{animation:drift 40s linear infinite}
    @keyframes drift{to{transform:translateX(-50%)}}
  </style>
  <script>
    const hero = document.querySelector<HTMLElement>('#hero')!, track = document.querySelector<HTMLElement>('#track')!;
    const drive = matchMedia('(hover:hover) and (pointer:fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!drive) { hero.classList.add('rail'); track.innerHTML += track.innerHTML; }   // loop for the ambient drift
    else {
      let travel = 0;
      const frame = () => { const p = Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / Math.max(1, travel))); track.style.transform = `translate3d(${(-p * travel).toFixed(1)}px,0,0)`; };
      const size = () => { travel = Math.max(0, track.scrollWidth - track.parentElement!.clientWidth); hero.style.height = `${innerHeight + travel * 1.2}px`; frame(); };
      addEventListener('scroll', frame, { passive: true }); addEventListener('resize', size); size();
    }
  </script>
</Base>
