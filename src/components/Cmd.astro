---
// one command in the session: the prompt, the command (a link when it leads somewhere), then its output.
const { cmd, href } = Astro.props;
---
<section class="cmd">
  <p class="line noprint"><span class="mu">❯</span> {href ? <a href={href}>{cmd}</a> : cmd}</p>
  <div class="out"><slot /></div>
</section>
<style>
  .cmd+.cmd{margin-top:1.4em}
  .out{margin-top:.4em}
  .out:empty{display:none}
</style>
